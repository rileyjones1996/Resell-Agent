# Copy this to .env and fill in your values
# DO NOT commit .env to version control

# Account settings
ACCOUNT_SIZE=50000.0
PAPER_MODE=true

# Apex-style risk limits
MAX_DAILY_LOSS_PCT=0.03        # 3% of account
MAX_TRAILING_DRAWDOWN_PCT=0.05 # 5% trailing drawdown
MAX_POSITION_SIZE_PCT=0.02     # 2% risk per trade
MAX_TRADES_PER_DAY=10

# Strategy parameters
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30
VWAP_DEVIATION_THRESHOLD=0.001
VWAP_ENABLED=true
SMA_PERIOD=20
STOP_SIZE_PCT=0.005          # 0.5% stop from entry price

# Data / logging / export
DATA_DIR=data
LOG_DIR=logs
EXPORT_DIR=exports
LOG_LEVEL=INFO
